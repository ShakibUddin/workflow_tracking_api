NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=workflow_tracking
DB_USER=postgres
DB_PASSWORD=
DB_DIALECT=postgres

LOG_LEVEL=info

# Overwrite these in every real deployment - the code falls back to insecure
# dev defaults so it still boots without a .env file.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=10

# Refresh tokens are opaque random strings (not JWTs) - only a lifetime.
REFRESH_TOKEN_TTL_DAYS=7
MAX_ACTIVE_SESSIONS_PER_USER=3
